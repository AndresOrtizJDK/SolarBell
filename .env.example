# Copiar a `.env` en la raíz. `compose.yaml` (producción) falla si falta alguna obligatoria.

# PostgreSQL. Obligatoria: POSTGRES_PASSWORD.
POSTGRES_DB=solarbell
POSTGRES_USER=solarbell
POSTGRES_PASSWORD=cambia-esta-clave

# API. Obligatoria: JWT_SECRET (>= 32 caracteres, p. ej. `openssl rand -hex 32`).
JWT_SECRET=cambia-esto-por-openssl-rand-hex-32
TZ=America/Bogota
# Lista JSON. Vacía si el frontend se sirve desde el mismo origen (nginx en `web`).
CORS_ORIGINS=[]
RING_PAUSE_MS=1000

# Usuario inicial: se crea solo si no existe. Obligatorias: ADMIN_EMAIL, ADMIN_PASSWORD.
ADMIN_EMAIL=admin@solarbell.local
ADMIN_PASSWORD=cambia-esta-clave
ADMIN_NAME=Admin

# Nodo ESP32. Obligatoria: DEVICE_API_KEY (la misma va como CLAVE_DISPOSITIVO en ESP32/solarbell_node/configuracion.h).
DEVICE_NAME=Campana
DEVICE_API_KEY=cambia-esto-por-openssl-rand-hex-16

# Puerto público de nginx.
WEB_PORT=80
